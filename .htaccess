<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and .env
    <Files .env>
        Order allow,deny
        Deny from all
    </Files>

    # Redirect all requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
